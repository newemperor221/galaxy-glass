---
import "../styles/base.css";
import Background from "../components/Background.tsx";
import QueryProvider from "../components/QueryProvider.tsx";

export interface Props {
  title?: string;
}
const { title = "银河探针" } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="theme-color" content="#0e152e" />
  <meta name="description" content="Komari Server Monitor" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20100%20100%22%3E%3Crect%20width%3D%22100%22%20height%3D%22100%22%20rx%3D%2216%22%20fill%3D%22%2310b981%22%2F%3E%3Ctext%20x%3D%2250%22%20y%3D%2268%22%20font-size%3D%2255%22%20text-anchor%3D%22middle%22%20fill%3D%22white%22%3EP%3C%2Ftext%3E%3C%2Fsvg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="min-h-full flex flex-col antialiased">
  <Background client:load />
  <div class="relative z-10 flex flex-col min-h-full">
    <QueryProvider client:load>
      <slot />
    </QueryProvider>
  </div>
</body>
</html>
